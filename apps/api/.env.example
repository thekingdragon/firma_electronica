# Copiar a .env (no se commitea). Base propia del servicio, NO la del host.
DATABASE_URL=postgres://usuario:clave@localhost:5432/firma_electronica
PORT=4000
# Secreto que deriva el token de cada link de firma (HMAC). Mínimo 32 caracteres, aleatorio
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
# No cambiarlo con solicitudes PENDING vivas: invalidaría sus links.
TOKEN_SECRET=
# Base pública de la página de firma; el link es <PUBLIC_BASE_URL>/s/<token>
PUBLIC_BASE_URL=http://localhost:5180

# Solo para `npm run test:e2e`. La base DEBE terminar en _test: la prueba la vacía.
# TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/firma_electronica_test

# Clave maestra (32 bytes) que cifra las contraseñas SMTP de los tenants y, después, los archivos.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, hay que volver a guardar las contraseñas de correo.
SECRETS_KEY=

# SOLO DESARROLLO: sin correo configurado, el OTP no se envía y viaja en la respuesta (devCode).
# El arranque se niega a combinarlo con NODE_ENV=production.
ALLOW_DEV_OTP=false

# Saltos de proxy delante de la API (1 con el túnel de Cloudflare), para guardar la IP real del
# firmante como evidencia. Sin esto se guardaría la del proxy.
# TRUST_PROXY=1
