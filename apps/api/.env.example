# Copiar a apps/api/.env (no se commitea). Base propia del servicio, NO la del host.
# El servicio lee este archivo desde su directorio de trabajo (apps/api).

# --- Obligatorias -------------------------------------------------------------------------------
DATABASE_URL=postgres://usuario:clave@localhost:5432/firma_electronica

# Deriva el token de cada link de firma y los hashes del código OTP (HMAC). Mínimo 32 caracteres,
# aleatorio. Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NO cambiarlo con solicitudes PENDING vivas: invalidaría sus links.
TOKEN_SECRET=

# Dirección pública (SIN barra final). El link de firma es <PUBLIC_BASE_URL>/s/<token>.
# En producción debe ser https: el navegador no ofrece la cámara en una conexión sin cifrar.
PUBLIC_BASE_URL=http://127.0.0.1:4000

# Clave maestra (32 bytes) que cifra las contraseñas SMTP, los secretos de webhook y los archivos
# (fotos y PDF). Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# RESPALDARLA donde estén los demás secretos: si se pierde, todo lo cifrado es irrecuperable. Sin ella
# el servicio arranca pero NO puede firmar (no puede guardar archivos cifrados).
SECRETS_KEY=

# --- Recomendadas en producción -----------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Dirección de escucha. 127.0.0.1 = solo esta máquina (con el túnel). 0.0.0.0 = también la red local.
HOST=127.0.0.1

# Carpeta de los archivos cifrados (fotos y PDF firmados). Fuera del repo y CON respaldo.
STORAGE_DIR=./storage

# Panel compilado (apps/web/dist). Si existe, la API lo sirve en la misma dirección: un solo proceso.
# La ruta es relativa a apps/api.
WEB_DIST_DIR=../web/dist

# Saltos de proxy delante de la API (1 con el túnel de Cloudflare). SIN esto la IP que se guarda como
# evidencia —y con la que se limitan las peticiones— sería la del túnel, no la del firmante: todos los
# firmantes compartirían un único cupo.
TRUST_PROXY=1

# Autoridad de sellado de tiempo (RFC 3161): da a cada firma una hora que no depende del reloj de este servidor. Solo se
# le manda la huella del PDF, nunca el documento. Recomendado en producción, p. ej. http://timestamp.digicert.com
# TSA_URL=

# El panel de operador (/operador) lo usa un usuario con rol OPERATOR (se crea con: npm run operator:create -w api).
# Por defecto no se abre por el túnel de Cloudflare; OPERATOR_ALLOW_REMOTE=true lo permite.

# --- Ajustes (los valores por defecto sirven) ---------------------------------------------------
# Entrega de webhooks, vencimiento de solicitudes y retención de fotos, en segundo plano.
BACKGROUND_JOBS=true
# Peticiones por minuto y por IP a los endpoints públicos de firma. Pedir el código y firmar tienen
# un cupo menor, derivado de este.
PUBLIC_RATE_LIMIT_PER_MIN=60

# --- SOLO DESARROLLO (el arranque se niega a combinarlas con NODE_ENV=production) ---------------
# Sin correo configurado, el OTP no se envía y viaja en la respuesta (devCode).
ALLOW_DEV_OTP=false
# Permite que un webhook apunte a localhost / redes privadas. En producción abriría la red interna.
WEBHOOK_ALLOW_PRIVATE=false

# --- Pruebas ------------------------------------------------------------------------------------
# Solo para `npm run test:e2e`. La base DEBE terminar en _test: la prueba la vacía.
# TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/firma_electronica_test
