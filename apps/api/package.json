{
  "name": "api",
  "version": "0.1.0",
  "description": "Microservicio de firma electrónica por solicitud, genérico por tipo de documento",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:grant": "ts-node src/db/grant.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "tenant:create": "ts-node src/tenants/create-tenant.ts",
    "test:e2e": "jest --config jest.e2e.json --runInBand",
    "tenant:mail": "ts-node src/tenants/set-tenant-mail.ts",
    "tenant:webhook": "ts-node src/tenants/set-tenant-webhook.ts",
    "template:publish": "ts-node src/tenants/publish-template.ts",
    "operator:create": "ts-node src/auth/operator-cli.ts create",
    "operator:reset": "ts-node src/auth/operator-cli.ts reset",
    "backup": "ts-node src/ops/backup.ts",
    "preflight": "ts-node src/ops/preflight.ts",
    "evidence:verify": "ts-node src/ops/verify-evidence.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "argon2": "^0.45.1",
    "dotenv": "^16.0.3",
    "fflate": "^0.8.3",
    "multer": "^2.4.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.14",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "smtp-server": "^3.19.17",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.e2e\\.spec\\.ts$"
    ]
  }
}
